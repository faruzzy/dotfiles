#!/usr/bin/env bash
# git here: where the current branch sits relative to the others, cropped to the lines around HEAD
# (`git lg` shows only the current branch).
#
#   git here           every branch, but only commits with a branch/tag name, plus the forks
#                      between them (--simplify-by-decoration: ~5 lanes instead of ~17)
#   git here --main    just this branch against the default branch's main line (--first-parent)
#   git here --full    every commit on every branch (dense; the old default)
#   git here -40       40 lines instead of 20 (combines with the modes)
#   git here -- path   any other arguments go to git log
#
# Dates are commit dates: a rebased commit keeps its old author date, which made a branch rebased
# onto today's main look days old.

set -euo pipefail

height=20
mode=decorated
while [[ $# -gt 0 ]]; do
  case "$1" in
    --main) mode=main; shift ;;
    --full) mode=full; shift ;;
    -[0-9]*)
      [[ $1 =~ ^-[0-9]+$ ]] || break
      height=${1#-}
      shift
      ;;
    *) break ;;
  esac
done

format='%C(bold blue)%h%C(reset) %C(bold green)%cr%C(reset) %C(dim white)%an%C(reset)%C(auto)%d%C(reset) %s'

# Only history newer than HEAD~height can land near HEAD; skip the rest so big repos stay fast
after=()
if since=$(git log -1 --format=%cI "HEAD~$height" 2>/dev/null); then
  after=(--after="$since")
fi

case "$mode" in
  decorated)
    graph=$(git log ${after[@]+"${after[@]}"} --all --simplify-by-decoration --graph --color=always --format="$format" "$@")
    ;;
  full)
    graph=$(git log ${after[@]+"${after[@]}"} --all --graph --color=always --format="$format" "$@")
    ;;
  main)
    # The default branch: origin/HEAD, else whichever of origin/main, origin/master exists
    base=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null || true)
    if [[ -z "$base" || "$base" == origin/HEAD ]]; then
      base=""
      for candidate in origin/main origin/master main master; do
        if git rev-parse --verify --quiet "$candidate" >/dev/null; then
          base=$candidate
          break
        fi
      done
    fi
    if [[ -z "$base" ]]; then
      echo "git here --main: no origin/HEAD, origin/main or origin/master to compare against" >&2
      exit 1
    fi
    graph=$(git log --first-parent --graph --color=always --format="$format" -n $(( height * 3 )) HEAD "$base" "$@")
    ;;
esac

# HEAD's line, found by its hash (the decoration could be anywhere in a subject)
head_hash=$(git rev-parse --short HEAD)
head_line=$(grep -nF -m1 -- "$head_hash" <<<"$graph" | cut -d: -f1 || true)
start=$(( ${head_line:-1} - height / 2 ))
(( start < 1 )) && start=1

# One sed rather than tail | head: head exiting early kills tail with SIGPIPE, which pipefail
# turns into a silent exit 141 in any repo with more history than the window
output=$(sed -n "${start},$(( start + height - 1 ))p" <<<"$graph")
if [ -t 1 ]; then
  less -FRSX <<<"$output"
else
  echo "$output"
fi
