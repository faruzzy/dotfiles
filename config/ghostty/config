# Ghostty configuration file
# Converted from Alacritty configuration

background-opacity = 1
# background-opacity = 0.9
# background-opacity-cells = true
# background-blur = 50

# Font configuration
# Apple's Monaco, unpatched: Ghostty draws Nerd Font icons from its built-in copy, sized like the
# normal (not Mono) variant. Monaco has no bold/italic faces, so Ghostty synthesizes them.
font-family = Monaco
font-size = 14.5
# font-family = "ComicShannsMono Nerd Font"
# font-size = 15.5
font-style = regular
font-style-bold = bold
font-style-italic = italic
macos-non-native-fullscreen = true

# Auto-start tmux for new windows
command = zsh -c "tmux new-session -A -s main"

bold-is-bright = true

# Window configuration
window-decoration = false
window-width = 160
window-height = 48
window-padding-x = 1
window-padding-y = 1

# Cursor configuration
cursor-style = block
cursor-style-blink = true
cursor-color = #827263

# Terminal behavior
scrollback-limit = 10000

# Mouse configuration
mouse-hide-while-typing = true

# Selection configuration
copy-on-select = true

theme = catppuccin-mocha.conf

macos-option-as-alt = left

shell-integration = detect
shell-integration-features = no-cursor,sudo,title
